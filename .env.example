# DocuMind RAG - Environment Variables Template
# Copy this file to .env and insert your actual API keys

# Sarvam AI API Key (optimized for Indic languages: Hindi, Marathi, English)
# Get your API key from: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Groq API Key (required for high-speed LLM fallback and English acceleration)
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Token (optional - for downloading embedding models)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here
