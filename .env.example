# Groq API Key for fast LLM inference (Tier 1 Generation & Fallback Translation)
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI API Key for Indic language translation (Tier 1 Multilingual Translation)
SARVAM_API_KEY=your_sarvam_api_key_here

# HuggingFace Token (Optional: higher rate limits for SentenceTransformers model downloads)
HF_TOKEN=your_hf_token_here

# Optional: Groq API configuration overrides
# GROQ_MODELS=llama-3.1-8b-instant,gemma2-9b-it,llama-3.3-70b-versatile
# GROQ_TIMEOUT=12
